      <element xsi:type="archimate:ServingRelationship" id="id-e314d2904394429b8c906f6d894e1df6" source="id-5b8727eaac2c436db9285b07a20649e6" target="id-a6ff0409f0a743e3b484891c75b53bb8"/>
      <element xsi:type="archimate:RealizationRelationship" id="id-6c543fa0bc884c0ea9531ffc03c8830f" source="id-2d99dc8136174976b9d7f68a2ed30efe" target="id-ef3517d30dfc458798ffe36ec7f791cf"/>
      <element xsi:type="archimate:RealizationRelationship" id="id-d4514627875e47ce9a1eb37a0c254355" source="id-2d99dc8136174976b9d7f68a2ed30efe" target="id-5b85b27ab53845bbb10df6915eef3806"/>
      <element xsi:type="archimate:RealizationRelationship" id="id-3adec0952dc744519bc392d42ceef9c8" source="id-35bf6c8298f34e57bd9ffa99877bc6e6" target="id-8c689ad2b44d44eebe0f1f10a21b4e44"/>
      <element xsi:type="archimate:FlowRelationship" name="Cliente y solicitud" id="id-be5a793b5bde4adf9f0edac8fc9948b5" source="id-ad644fdca47f42b8ba22dfa7a62a88a7" target="id-33da0a71434043eda8306948f9bd797a">
        <documentation>Sale: Datos del cliente y su solicitud cuando consulta o reserva.</documentation>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="Datos del cliente" id="id-f1c588c9be6c4407b510f0b1e4d103ee" source="id-33da0a71434043eda8306948f9bd797a" target="id-ad644fdca47f42b8ba22dfa7a62a88a7">
        <documentation>Entra: Datos de un cliente que ya existe cuando vuelve a pedir un arriendo.</documentation>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="Datos para el contrato" id="id-1687d8d5c94148c68c2ef6d784f2a9fb" source="id-b170a04e21cc4665abdb81d9ba6eaea1" target="id-03be3f82b87240b1bbabf2bfd90332eb">
        <documentation>Sale: Datos para el contrato del cliente (cliente, yate, fechas y valores) después del riesgo aceptable; datos para el contrato del propietario al vincularlo.</documentation>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="Contrato firmado" id="id-acf3d8e59813415cbec517a59a0b77d1" source="id-03be3f82b87240b1bbabf2bfd90332eb" target="id-b170a04e21cc4665abdb81d9ba6eaea1">
        <documentation>Entra: Contrato del cliente firmado con sus condiciones de cancelación; contrato del propietario firmado, una sola vez al comenzar la relación.</documentation>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="Datos del arriendo; reclamo con evidencia" id="id-0b3ade0eb10b4e7ab63cead21e8e2c66" source="id-f1b972c2ebb54b5dbc49d796af031b80" target="id-f4037231726941f09e22e186b1de8207">
        <documentation>Sale: Al reservar: yate, cliente y fechas del arriendo. Al cerrar, solo si el daño supera el depósito: reclamo con la evidencia de la entrega y de la inspección.</documentation>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="Póliza; respuesta al reclamo" id="id-d1589a8e562f45179b32fa87f6424aee" source="id-f4037231726941f09e22e186b1de8207" target="id-f1b972c2ebb54b5dbc49d796af031b80">
        <documentation>Entra: Póliza del arriendo; respuesta de la aseguradora al reclamo.</documentation>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="Datos del cliente autorizados" id="id-0b2a293800be47c98924d60edc97f0b0" source="id-0e97a5a8825341a6a90e40fc329cc037" target="id-5f4527133542439390074ce89735da3c">
        <documentation>Sale: Datos del cliente que autorizó compartir.</documentation>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="Nivel de riesgo" id="id-5ae3027a64484a2cafdf05e507cdea5b" source="id-5f4527133542439390074ce89735da3c" target="id-0e97a5a8825341a6a90e40fc329cc037">
        <documentation>Entra: Nivel de riesgo: bajo, medio o alto.</documentation>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="Aviso de reserva; alerta de señal" id="id-c47902f75e514367bd9ca5d76f96e1fe" source="id-35bf6c8298f34e57bd9ffa99877bc6e6" target="id-1ee9c918301349ffbb9d44e6828b02d4">
        <documentation>Sale: Aviso de la reserva confirmada (yate, fechas y cliente) y alerta de pérdida de señal. La ubicación y el combustible durante el arriendo la marina los consulta en el servicio de seguimiento, sin cambiar sus sistemas.</documentation>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="Actas de entrega e inspección" id="id-e4cb34097ff14facb770244413386677" source="id-1ee9c918301349ffbb9d44e6828b02d4" target="id-35bf6c8298f34e57bd9ffa99877bc6e6">
        <documentation>Entra: En la entrega, acta y fotos. En la devolución, inspección con fotos, nivel de combustible y hora de regreso.</documentation>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="Órdenes de cobro y del depósito" id="id-e4d8cd97d8e04388b1060851e06a0948" source="id-d8cd158de4664c6c931d276887de2c58" target="id-a03086a44e7343a484d5072f77aacc94">
        <documentation>Sale: Órdenes de cobro (alquiler, seguro, combustible y tiempo adicional), bloqueo del depósito, liberación o descuento del depósito y reembolsos.</documentation>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="Aprobación o rechazo" id="id-0233b337eba8447698cabe155e6f6667" source="id-a03086a44e7343a484d5072f77aacc94" target="id-d8cd158de4664c6c931d276887de2c58">
        <documentation>Entra: Confirmación o rechazo de cada orden, código de autorización y vencimiento del bloqueo.</documentation>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="Ubicación y combustible" id="id-45fe8f34ea3f41a180673dd4ced44bdb" source="id-36cc760eb70f4f74be7dc693be15ffb8" target="id-b89074202bab43d1808b22fb2d5ebdb1">
        <documentation>Entra: Lecturas del dispositivo de cada yate: posición, nivel de combustible y hora, sobre todo desde la entrega hasta la devolución.</documentation>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="Valores del arriendo cerrado" id="id-e97ede45987d4969ace00ba1f75b6f11" source="id-5b8727eaac2c436db9285b07a20649e6" target="id-2436b7f69f814e539e5d62b6168b8f70">
        <documentation>Sale: Por cada arriendo cerrado: propietario, yate, valor del alquiler, comisión de YateGear y valor que le corresponde al propietario.</documentation>
      </element>
      <element xsi:type="archimate:AggregationRelationship" id="id-14a0806ff5c04c4492798c7b96765e09" source="id-7aff3bd0787d4ba2a41be7a4fd658afd" target="id-28f58751c0304bd9820b0e53f78eb0e6"/>
