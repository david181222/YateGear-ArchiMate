    <element xsi:type="archimate:AggregationRelationship" id="id-a0b2ca0022c5485f8a1668f17859af92" source="id-109bb52ebcd24fff932f2455c48eb8fb" target="id-bb470d63486b4dc3bec2b5b1ccfaca63"/>
    <element xsi:type="archimate:AggregationRelationship" id="id-c12b1b0546834317941646ea5e997e2f" source="id-109bb52ebcd24fff932f2455c48eb8fb" target="id-309f584189aa44d1b4098977798b22a3"/>
