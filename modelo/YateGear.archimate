    <element xsi:type="archimate:RealizationRelationship" id="id-cbf8bb65d3364f3caa43f4cc98f3b132" source="id-33c0b1acb12b423ca7ea1a041acf4644" target="id-5fb7e363b5ce42bcbad1ebf839fbaa9d"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-8843312f0f334c4ebc255d75a33a28f5" source="id-33c0b1acb12b423ca7ea1a041acf4644" target="id-964f4b7bde7a403089056d61347e2de1"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-eff9b5b66ea8475d9c07f7b485fcce14" source="id-6c309680f28e40aca943f353b2c081f4" target="id-621d13a80279476681364e5f160f18c6">
      <documentation>Supuesto: las calificaciones sirven para saber si el negocio va bien y dan confianza a ambos lados (conversación E2E-07).</documentation>
    </element>
    <element xsi:type="archimate:InfluenceRelationship" id="id-bca038597b00448e9804257a6c4797a7" source="id-9554315b82af448c935c6bdfca3ae1b8" target="id-621d13a80279476681364e5f160f18c6">
      <documentation>Supuesto: el experto dijo que el presupuesto limita la solución (conversación MOT-04); que el destino sea la meta &quot;Crecer con control&quot; es decisión del equipo.</documentation>
    </element>
    <element xsi:type="archimate:InfluenceRelationship" id="id-f96eb5221dbc491a88f38760369cf279" source="id-8c689ad2b44d44eebe0f1f10a21b4e44" target="id-546d30390bbd44d88f6b3917ead4da62">
      <documentation>Supuesto: la notificación de la reserva a la marina debe adaptarse a sus sistemas, que no van a cambiar (conversación MOT-04, INT-MAR).</documentation>
    </element>
    <element xsi:type="archimate:InfluenceRelationship" id="id-62a92cf5e3384402954f9c710cac90b2" source="id-8c689ad2b44d44eebe0f1f10a21b4e44" target="id-57a515ead614491ba46e6b651b1e3587">
      <documentation>Supuesto: el seguimiento visible para la marina debe funcionar sin que la marina cambie sus sistemas (conversación MOT-04).</documentation>
    </element>
    <element xsi:type="archimate:InfluenceRelationship" id="id-2f788f67580644b9ab6c0c109200c6fd" source="id-8c689ad2b44d44eebe0f1f10a21b4e44" target="id-33c0b1acb12b423ca7ea1a041acf4644">
      <documentation>Supuesto: la inspección, las fotos y la hora de regreso se reciben de la marina sin que ella cambie sus sistemas (conversación MOT-04, INT-MAR).</documentation>
    </element>
    <element xsi:type="archimate:InfluenceRelationship" id="id-97c407968518474bbcf27cf51106fcb1" source="id-a64ed4f6b2734ba6ad768ab854f35b66" target="id-ef3517d30dfc458798ffe36ec7f791cf"/>
