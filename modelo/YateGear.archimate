    <folder name="Fase 3" id="id-21ef420b48e446e8a7f42f9a3f5ad439">
      <element xsi:type="archimate:AggregationRelationship" id="id-6049c83c799345b19f01376c42baf9e6" source="id-fd740c766eed463183ec8c8ccbd47179" target="id-a44be1314fc14a9092a23f2528ef5824">
        <documentation>El dominio Gestión del arriendo se clasifica como subdominio central (V5-DEC-05).</documentation>
      </element>
      <element xsi:type="archimate:AggregationRelationship" id="id-da562ab671f14d95bfba35373538e5ff" source="id-fd740c766eed463183ec8c8ccbd47179" target="id-d44425d2648b464eb5b71275e2978c41">
        <documentation>El dominio Cobros y depósito se clasifica como subdominio central (V5-DEC-05).</documentation>
      </element>
      <element xsi:type="archimate:AggregationRelationship" id="id-c925148826cb4516b0e5ea171f50aac9" source="id-580878ecbee54e66b786b8feeb19bb15" target="id-3de9c3a6e34d48f6a1fcd6a828471dd0">
        <documentation>El dominio Disponibilidad de yates se clasifica como subdominio de soporte (V5-DEC-05).</documentation>
      </element>
      <element xsi:type="archimate:AggregationRelationship" id="id-62aa4b93afba4f72a5516a6062a35ddd" source="id-580878ecbee54e66b786b8feeb19bb15" target="id-41501569cf094ac4b3cc80b4ab439a97">
        <documentation>El dominio Operación del arriendo se clasifica como subdominio de soporte (V5-DEC-05).</documentation>
      </element>
      <element xsi:type="archimate:AggregationRelationship" id="id-a12b847806fe451c803bc3c577077f5f" source="id-67cb5948530d471fbbe233cafb84ebf3" target="id-1c7b577ca7d04284ab10399e9b7ab37f">
        <documentation>El dominio Calificaciones se clasifica como subdominio genérico (V5-DEC-05).</documentation>
      </element>
      <element xsi:type="archimate:AggregationRelationship" id="id-00c722a10f2444938e03a82a9d77e9c7" source="id-a44be1314fc14a9092a23f2528ef5824" target="id-10939f7fb6a0418f90ccf55c07818630">
        <documentation>El dominio Gestión del arriendo es dueño de &quot;Arriendo&quot;: en la V4 lo escriben SB-06, SB-07, SB-08 y SB-09 (SD-02) (V5-DEC-02).</documentation>
      </element>
      <element xsi:type="archimate:AggregationRelationship" id="id-d8ca4a35eeb5416e944ce01a36aada0c" source="id-a44be1314fc14a9092a23f2528ef5824" target="id-10b68119c12642c9aefd57f1a0a7b83b">
        <documentation>El dominio Gestión del arriendo es dueño de &quot;Evaluación de riesgo&quot;: en la V4 la escribe SB-12 (SD-03) (V5-DEC-02).</documentation>
      </element>
