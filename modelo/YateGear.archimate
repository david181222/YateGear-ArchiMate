    <element xsi:type="archimate:AssociationRelationship" id="id-48b4a31721b04a8b82e0c2481fba0ba0" source="id-f2b7c697a45d44838384ebb864258902" target="id-f3bd2a65f222489a81ab9417aa473526"/>
    <element xsi:type="archimate:InfluenceRelationship" id="id-0de1cea4207b4c4bbce611b7179649f4" source="id-99f66a03374649a4921b41e38586dfa7" target="id-cd2aae7f14b841f49a018ca78168a647"/>
    <element xsi:type="archimate:InfluenceRelationship" id="id-9ed68b7161254306a210703af303ba63" source="id-32f930d7bca84572b0932bad7bc5ec9d" target="id-51586775745047d1a124b405821fe49c"/>
    <element xsi:type="archimate:InfluenceRelationship" id="id-68ee7d7e0e8c44169e886785b8823cf0" source="id-fce900f475db46238afe616595a7abdf" target="id-51586775745047d1a124b405821fe49c">
      <documentation>Supuesto: el experto no dijo a qué meta aporta la demora del depósito; se deduce porque devolver o retener el depósito es un ajuste que depende de evidencia clara (conversación E2E-06).</documentation>
    </element>
    <element xsi:type="archimate:InfluenceRelationship" id="id-fea36a05638f4e9a8040c110f7673df7" source="id-f3bd2a65f222489a81ab9417aa473526" target="id-58a48a584ec14cff98423a6dbc697a93"/>
    <element xsi:type="archimate:AggregationRelationship" id="id-adef20e02165454d9368b36424f5dead" source="id-621d13a80279476681364e5f160f18c6" target="id-cd2aae7f14b841f49a018ca78168a647">
      <documentation>Supuesto: agrupar las metas en «Crecer con control» es decisión del equipo; el experto expresó «crecer con control» como expectativa de la gerencia (conversación MOT-02).</documentation>
    </element>
    <element xsi:type="archimate:AggregationRelationship" id="id-6c6839df2a884d53875986236586c1d1" source="id-621d13a80279476681364e5f160f18c6" target="id-51586775745047d1a124b405821fe49c">
      <documentation>Supuesto: agrupar las metas en «Crecer con control» es decisión del equipo; el experto expresó «crecer con control» como expectativa de la gerencia (conversación MOT-02).</documentation>
    </element>
    <element xsi:type="archimate:AggregationRelationship" id="id-3ad534249ef6452f83b69f00c40d92ad" source="id-621d13a80279476681364e5f160f18c6" target="id-58a48a584ec14cff98423a6dbc697a93">
      <documentation>Supuesto: agrupar las metas en «Crecer con control» es decisión del equipo; el experto expresó «crecer con control» como expectativa de la gerencia (conversación MOT-02).</documentation>
    </element>
    <element xsi:type="archimate:RealizationRelationship" id="id-c9cdb17106b94055bdd67bcf710ce22e" source="id-026bc444cde74663a10d12e9c3884c51" target="id-51586775745047d1a124b405821fe49c"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-1f780ecdee4e4398be9f34c5ee285c9b" source="id-964f4b7bde7a403089056d61347e2de1" target="id-51586775745047d1a124b405821fe49c">
      <documentation>Supuesto: devolver el depósito a tiempo depende de ajustes claros y con evidencia (conversación E2E-06).</documentation>
    </element>
    <element xsi:type="archimate:RealizationRelationship" id="id-176d16606d454a458c80a121da0e796b" source="id-bdb763d4b5ad4c75af74a4e636512997" target="id-58a48a584ec14cff98423a6dbc697a93"/>
