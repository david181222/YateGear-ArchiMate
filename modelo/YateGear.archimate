    <element xsi:type="archimate:AssignmentRelationship" id="id-3329b42bb24d493cb2792799450d82f8" source="id-6e6e67926ee748ef97c3ee84e2f12806" target="id-2436b7f69f814e539e5d62b6168b8f70">
      <documentation>Fuente: H-11; conversación ACT-01, E2E-04.</documentation>
