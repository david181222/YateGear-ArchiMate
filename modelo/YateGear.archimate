    <element xsi:type="archimate:AssociationRelationship" id="id-8e4ad58e3fb84ed7957c7b9595686656" source="id-40ce275a4ca744e3a86cd10c64623987" target="id-7f2ab8fc0f8a4ca688b339a173b245c8"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-992d7e0d526146f6b44c7f982174b559" source="id-40ce275a4ca744e3a86cd10c64623987" target="id-f2b7c697a45d44838384ebb864258902"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-85d83af369b34355b251e3151959784b" source="id-bdf4c2c94e1e4cdebef4c88fe9d5448e" target="id-f2b7c697a45d44838384ebb864258902"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-5387bc42b9fb40058c81025d8b881728" source="id-33b10fd26566417a9a47de80d5c77c1f" target="id-99f66a03374649a4921b41e38586dfa7"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-cc8095b7ffa144f9b2e6ac74417a2e2a" source="id-33b10fd26566417a9a47de80d5c77c1f" target="id-fce900f475db46238afe616595a7abdf">
      <documentation>Supuesto: el cierre manual no da abasto con más arriendos.</documentation>
    </element>
    <element xsi:type="archimate:AssociationRelationship" id="id-0752f0cd2bd3490b8b4a1dad477fe47e" source="id-7f2ab8fc0f8a4ca688b339a173b245c8" target="id-99f66a03374649a4921b41e38586dfa7"/>
