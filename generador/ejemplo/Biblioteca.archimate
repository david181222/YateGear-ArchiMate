<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Biblioteca" id="id-2978acbbf99b509f9ea9ee63176d70ae" version="5.0.0">
  <folder name="Strategy" id="id-f523566101e05b64a1bbaad6a5c895a2" type="strategy"/>
  <folder name="Business" id="id-7d9e5e7207e85771a267364528214a54" type="business">
    <element xsi:type="archimate:BusinessService" name="Prestar un libro" id="id-2c4ab840149c5f6bb997fd138b8d7665">
      <documentation>Servicio de negocio SB-01.</documentation>
      <property key="Código" value="SB-01"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato de servicio: Prestar un libro" id="id-ae3bbf116893597ab208483228f70381">
      <documentation>Contrato del servicio SB-01 "Prestar un libro".
Entrada: Lector, libro y plazo del préstamo (desde y hasta).
Salida: Préstamo con su número, en estado prestado.
Reglas: REG-01: se rechaza si el catálogo dice que el libro no está disponible.</documentation>
      <property key="Servicio" value="SB-01"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Devolver el libro" id="id-48151143e7315060b5a0ceed638aadcf">
      <documentation>Servicio de negocio SB-02.</documentation>
      <property key="Código" value="SB-02"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato de servicio: Devolver el libro" id="id-be012cf9cf7a573c8176e8e3dadd4814">
      <documentation>Contrato del servicio SB-02 "Devolver el libro".
Entrada: Número del préstamo.
Salida: Préstamo devuelto.
Reglas: Solo se devuelve un libro prestado.</documentation>
      <property key="Servicio" value="SB-02"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Consultar el préstamo" id="id-a17fb94b9d105e6cb5ec8095d9d61062">
      <documentation>Servicio de negocio SB-03.</documentation>
      <property key="Código" value="SB-03"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato de servicio: Consultar el préstamo" id="id-1eb53a4c5895511dba1b123b4317670e">
      <documentation>Contrato del servicio SB-03 "Consultar el préstamo".
Entrada: Número del préstamo.
Salida: Estado del préstamo, lector, libro y fecha en que vence.</documentation>
      <property key="Servicio" value="SB-03"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Catálogo de la biblioteca" id="id-291efe88ae465b5b839afcfd422c02da">
      <documentation>Servicio de negocio SA-01.</documentation>
      <property key="Código" value="SA-01"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato de servicio: Catálogo de la biblioteca" id="id-5ee7ad76766c50d7abc0cfeea3d26980">
      <documentation>Contrato del servicio SA-01 "Catálogo de la biblioteca".
Entrada: El libro.
Salida: Si el libro está disponible.
Reglas: La aplicación no cambia el catálogo; solo lo consulta.</documentation>
      <property key="Servicio" value="SA-01"/>
    </element>
  </folder>
  <folder name="Application" id="id-3c13bec2cfe054dbb1b42610b3db55d1" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Contexto Préstamos" id="id-ccd77ee8d6e85373b2058f86905a7b2c">
      <documentation>Contexto delimitado de los préstamos de libros de una biblioteca. Ejemplo mínimo del generador: un agregado, dos comandos, una consulta y un servicio de la capa anticorrupción.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Préstamo" id="id-8fc36207505e52cc9ef19a99e47dfca7">
      <documentation>Raíz del agregado: el préstamo de un libro a un lector. Identidad: el número del préstamo. Estados: prestado y devuelto.</documentation>
      <property key="Tipo DDD" value="Raíz"/>
      <property key="Campo: lector" value="string"/>
      <property key="Campo: libro" value="string"/>
    </element>
    <element xsi:type="archimate:DataObject" name="Plazo del préstamo" id="id-23f42c26c59a58d4b094e7c17ba625f7">
      <documentation>Objeto de valor: desde cuándo y hasta cuándo se presta el libro.</documentation>
      <property key="Tipo DDD" value="Objeto de valor"/>
      <property key="Campo: desde" value="DateOnly"/>
      <property key="Campo: hasta" value="DateOnly"/>
    </element>
    <element xsi:type="archimate:ApplicationProcess" name="Prestar un libro" id="id-adbef6a6733f58f5a9e0ba51f136a4ac">
      <documentation>Comando: presta un libro a un lector, si el catálogo dice que está disponible.</documentation>
      <property key="Servicio básico V4" value="SB-01"/>
    </element>
    <element xsi:type="archimate:ApplicationProcess" name="Devolver el libro" id="id-5bf799b38b425df3b814b33aa2929f70">
      <documentation>Comando: el lector devuelve el libro.</documentation>
      <property key="Servicio básico V4" value="SB-02"/>
    </element>
    <element xsi:type="archimate:ApplicationEvent" name="Libro prestado" id="id-7808c0a36e435cbeb9af1243ed983bec">
      <documentation>El libro quedó prestado al lector.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationEvent" name="Libro devuelto" id="id-4baadb7858ae500cb39ea7b0dc99f59c">
      <documentation>El lector devolvió el libro.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Consultar el préstamo" id="id-b3770e1c734d569ca65ced6e4d6ce41a">
      <documentation>Consulta: el estado de un préstamo y hasta cuándo va.</documentation>
      <property key="Servicio básico V4" value="SB-03"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Catálogo de la biblioteca" id="id-ae10d4fa9958587aa03b1c8536870bb3">
      <documentation>Servicio de la capa anticorrupción: pregunta al sistema del catálogo si el libro está disponible.</documentation>
      <property key="Servicio anticorrupción V4" value="SA-01"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Interfaz del catálogo" id="id-bd12ff4c48e651eb91ff722ffd2d41fe">
      <documentation>Interfaz por la que se consulta el catálogo.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Sistema del catálogo" id="id-f96fb87fb5e759699af89f8e28598a96">
      <documentation>Sistema externo con el catálogo de la biblioteca.</documentation>
      <property key="Externo" value="Sí"/>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-8cdd44c8438450daabaefc928b7dec70" type="technology"/>
  <folder name="Motivation" id="id-1252442f23f65f8284e4fc344366a86d" type="motivation"/>
  <folder name="Implementation &amp; Migration" id="id-7f9789aedd3c5cb49812f0c078754266" type="implementation_migration"/>
  <folder name="Other" id="id-004438899c9a5613a736de086683e9d2" type="other">
    <element xsi:type="archimate:Grouping" name="Agregado Préstamo" id="id-94a54a4626ed53a3bea811adf0f8258a">
      <documentation>Límite del agregado Préstamo: su raíz, su objeto de valor, sus comandos y sus eventos.</documentation>
    </element>
  </folder>
