<Project Sdk="Microsoft.NET.Sdk">
  <!-- {{ cabecera }} -->
  <!-- Bus entre contextos (D1): lo referencian el host y cada contexto. No conoce ningún contexto. -->
  <PropertyGroup>
    <TargetFramework>{{ net }}</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Cero advertencias: una advertencia, también en el código a mano, detiene la compilación. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>{{ ns_integracion }}</RootNamespace>
  </PropertyGroup>
</Project>
