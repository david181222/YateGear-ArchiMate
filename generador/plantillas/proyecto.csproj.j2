<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- {{ cabecera }} -->
  <!-- Biblioteca del contexto: la levanta el host. Solo referencia al bus entre contextos, nunca a otro contexto (D1). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>{{ ns }}</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\{{ integracion }}\{{ integracion }}.csproj" />
  </ItemGroup>
{% if huerfanos %}
  <!-- Archivos manuales huérfanos excluidos de la compilación. El generador no los borra porque son
       código escrito a mano; se excluyen porque su .g.cs ya no existe y sin él no compilan.
       Revísalos: rescata lo que sirva y bórralos a mano. -->
  <ItemGroup>
{% for h in huerfanos %}
    <!-- {{ h.ruta }}: ya no existe {{ h.falta }} (el comando o la consulta ya no está en el modelo o en el YAML). -->
    <Compile Remove="{{ h.ruta }}" />
{% endfor %}
  </ItemGroup>
{% endif %}
</Project>
